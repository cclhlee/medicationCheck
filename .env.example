# 本機 PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/YOUR_EXISTING_DATABASE
DB_SCHEMA=public

# Supabase（Connect → Session pooler 的連線字串，密碼只放環境變數）
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SCHEMA=week10

# 選用：DB_SSL=on/off 可覆寫自動判斷（遠端主機預設開啟 TLS，本機預設關閉）
# 選用：DB_POOL_MAX 每個執行實例的連線數上限，serverless 建議維持 1
